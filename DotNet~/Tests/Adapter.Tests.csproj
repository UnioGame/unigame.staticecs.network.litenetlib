<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameRepositoryRoot Condition="'$(GameRepositoryRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../../'))</GameRepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Runtime/LiteNetLibTransport.cs" Link="Runtime/LiteNetLibTransport.cs" />
    <Compile Include="../../Tests/Editor/LiteNetLibAdapterTests.cs" Link="Tests/LiteNetLibAdapterTests.cs" />
    <Compile Include="../../../unigame.staticecs.network/Protocol/*.cs" Link="Protocol/%(Filename)%(Extension)" />
    <Compile Include="$(GameRepositoryRoot)/GameClient/Library/PackageCache/com.felid-force-studios.static-pack@5ecf19df31a2/Src/**/*.cs" Link="StaticPack/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(GameRepositoryRoot)/GameClient/Library/PackageCache/com.felid-force-studios.static-ecs@23b1cf36d894/Src/**/*.cs" Link="StaticEcs/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../../unigame.staticecs.network/Runtime/MemoryNetworkTransport.cs" Link="Network/MemoryNetworkTransport.cs" />
    <Compile Include="../../../unigame.staticecs.network/Runtime/NetworkSessionContracts.cs" Link="Network/NetworkSessionContracts.cs" />
  </ItemGroup>
</Project>
